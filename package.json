{
  "name": "hamyar",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-superadmin.ts",
    "worker:exams": "node --env-file-if-exists=.env --import tsx scripts/exam-worker.ts",
    "ocr:setup": "node scripts/setup-ocr.mjs",
    "dev": "node scripts/check-dev-port.mjs && next dev --hostname 127.0.0.1 --port 5174",
    "build": "next build --webpack && node scripts/pwa.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=4 --test-timeout=120000 tests/unit/*.test.ts tests/unit/*.test.mjs tests/integration/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "format": "prettier --write src tests scripts docs *.json *.ts *.mjs",
    "audit:integrity": "node --env-file-if-exists=.env --import tsx scripts/audit-integrity.ts",
    "migrate:replica": "node --env-file-if-exists=.env --import tsx scripts/copy-to-replica.ts",
    "mongo:init": "node --env-file-if-exists=.env scripts/init-replica.mjs",
    "smoke:ollama": "node --env-file-if-exists=.env --import tsx scripts/smoke-ollama.ts",
    "rebuild:learning": "node --env-file-if-exists=.env --import tsx scripts/rebuild-learning.ts",
    "verify:backup": "node --env-file-if-exists=.env --import tsx scripts/verify-backup.ts",
    "ops:status": "node --env-file-if-exists=.env --import tsx scripts/check-runtime.ts",
    "smoke:load": "node --env-file-if-exists=.env --import tsx scripts/load-health.ts",
    "predev": "node scripts/prepare-font.mjs",
    "prebuild": "node scripts/prepare-font.mjs",
    "worker:mail": "node --env-file-if-exists=.env --import tsx scripts/mail-worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.2.0",
    "mongodb": "^6.20.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0"
  }
}
