MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=hamyar-rs
MONGO_DB=hamyar
COOKIE_SECURE=false
AI_PROVIDER=mock
APP_ORIGIN=http://127.0.0.1:5174
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=30000
AI_FALLBACK=none

AI_AUTHOR_TIMEOUT_MS=90000
# Optional dedicated installed authoring model; otherwise OLLAMA_MODEL is used
# OLLAMA_AUTHOR_MODEL=qwen2.5:3b

# AvvalAI handles authoring and student hint selection when a teacher model/key is configured.
# AI_PROVIDER remains the explicit local/mock provider when AvvalAI is not configured.
AI_AUTHOR_PROVIDER=avalai
AVALAI_API_KEY=
# Optional server default; teachers may choose a model in /settings.
AVALAI_AUTHOR_MODEL=

# Local PDF text extraction (Poppler). Install pdftotext on the server.
PDFTOTEXT_BIN=pdftotext

# Local OCR: npm run ocr:setup before starting the dedicated worker.
# No model downloads or external AI calls occur during document requests.
OCR_DATA_DIR=.private/ocr
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
EXAM_SOURCE_RETENTION_DAYS=7
# Run one or more worker processes; a MongoDB lease enforces one active document job.
# npm run worker:exams

# Password reset email delivery: implicit TLS SMTP (port 465 only).
# In production APP_ORIGIN must use HTTPS. Store credentials as deployment secrets.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
